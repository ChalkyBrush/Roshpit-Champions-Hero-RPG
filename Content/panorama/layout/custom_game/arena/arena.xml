<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/arena/arena.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/arena/arena.js" />
	</scripts>
	<snippets>
		<snippet name="arena_scoreboard">
			<Panel class="arena_scoreboard" hittest="false">
				<Panel class="arena_scoreboard_bg" hittest="false">
				</Panel>
				<Panel id="leadboard_title">
					<Panel class="arena_leaderboard_title_bg" hittest="false">
					</Panel>
					<Label id="leaderboard_title_text" text="arena_left_leaderboard_title" hittest="false"></Label>
				</Panel>
				<Panel id="leaderboard-leaders-box">
				</Panel>
			</Panel>
		</snippet>
		<snippet name="arena_list_item">
			<Panel class="arena_list_item" hittest="false">

				<Image id="trophy_image"></Image>
				<Panel id="list_item_rank_container">
					<Panel class="arena_list_item_bg" hittest="false">
					</Panel>
					<Label id="list_item_rank" text="0." hittest="false"></Label>
				</Panel>
				<Panel id="list_item_name_container">
					<Panel class="arena_list_item_name_bg">
					</Panel>
					<Label id="list_item_name" text="0." hittest="false"></Label>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="arena_npc_dialogue">
			<Panel class="dialogue_container" hittest="false">
				<Panel class="dialogue_main_bg" hittest="false">
				</Panel>
<!-- 				<DOTAScenePanel hittest="false" id="dialogue_background" map="backgrounds/dashboard_parallax_test" camera="shot_cameraC"/> -->
				<Panel id="dialogue_contents">
					<Panel id="dialogue_header" hittest="false">
						<Panel id="dialogue_portrait" hittest="false">
						</Panel>
						<Label id="dialogue_name" text="dialogue_name" hittest="false"></Label>
					</Panel>
					<Panel id="dialogue_text" hittest="false">
						<Panel id="dialogue_text_bg" hittest="false"></Panel>
						<Label id="dialogue_text_text" text="dialogue_text" hittest="false"></Label>
					</Panel>
					<Panel id="dialogue_options" hittest="false">
						<Button class="dialogue_button" id="option1">
							<Label class="dialogue_button_label" id="dialogue_label1" text="test" html="true"></Label>
							<Panel id="dialogue_price_box" class="invisible">
								<Image id="dialogue_resource_image" src="file://{images}/custom_game/ui/mithril_shard.png" />
								<Label id="dialogue_price_amount" text="0" html="true"></Label>
							</Panel>
						</Button>
						<Button class="dialogue_button" id="option2">
							<Label class="dialogue_button_label" id="dialogue_label2" html="true"></Label>
						</Button>
					</Panel>
				</Panel>
		</Panel>
		</snippet>
		<snippet name="arena_sign">
			<Panel class="sign_container" hittest="false">
				<Panel id="sign_bg" hittest="false">
				</Panel>
				<Label id="sign_label" hittest="false"></Label>
			</Panel>
		</snippet>
		<snippet name="arena_terminal">
			<Panel class="arena_terminal_container" hittest="false">
				<Panel class="terminal_main_bg" hittest="false">
				</Panel>
				<Panel id="terminal_content" hittest="false">
					<Panel id="terminal_header" hittest="false">
						<Label id="terminal_header_text" text="dialogue_name" hittest="false"></Label>
					</Panel>
					<Panel id="left_terminal" hittest="false">
						<Panel id="hero_portrait" hittest="false"></Panel>
						<Label id="hero_name_text" text="dialogue_name" hittest="false"></Label>
						<Panel id="trophy_box" hittest="false">
						</Panel>
						<Panel id="rank_box" hittest="false">
							<Label id="rank_label" text="terminal_rank_display" hittest="false"/>
							<Label id="rank_value" text="--" hittest="false"/>
						</Panel>

					</Panel>
					<Panel id="right_terminal" hittest="false">
						<Panel id="right_terminal_column_a" class="invisible">
							<Label id="wins_label" class="terminal_text" text="terminal_high_score" hittest="false"/>
							<Panel class="horizontal-space"></Panel>
							<Label id="fame_label" class="terminal_text" text="terminal_opponent_rank" hittest="false"/>
						</Panel>
						<Panel id="right_terminal_column_b" class="invisible">
							<Label id="wins_value" class="terminal_text" text="0" hittest="false"/>
							<Panel class="horizontal-space"></Panel>
							<Label id="fame_value" class="terminal_text" text="0" hittest="false"/>
						</Panel>
						<Panel id="champions_league_opponent_container">
							<Label id="enemy_name_text" text="terminal_opponent_unselected" hittest="false"></Label>
							<Panel id="enemy_portrait" hittest="false"></Panel>
							<Label id="champion_high_score_text" text="" hittest="false" class="invisible"></Label>
						</Panel>
						<Panel id="champions_league_change_challenger_button">
							<Label id="champions_league_change_challenger_button_label" text="terminal_choose_opponent" hittest="false"/>
						</Panel>
						<Panel id="champions_league_start_button">
							<Label id="champions_league_start_button_label" text="start_champions_league_battle" hittest="false"/>
						</Panel>
					</Panel>
					<Panel id="opponent_select_box">
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="champions_league_opponent_select">
			<Panel class="champions_league_opponent_select_container" hittest="false">
				<Panel class="opponent_select_main_bg" hittest="false">
				</Panel>
				<Label id="champions_league_select_opponent_title" text="terminal_choose_opponent" hittest="false"/>
				<Panel id="terminal_opponent_buttons_container">
					<Panel id="right_terminal_column_a_opponent">
					</Panel>
					<Panel id="right_terminal_column_b_opponent">
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="champions_league_opponent_select_individual">
			<Panel class="champions_league_opponent_select_individual_container">
				<Label id="champions_opponent_label" text="" hittest="false"/>
			</Panel>
		</snippet>
		<snippet name="arena_battle_timer">
			<Panel class="arena_timer_container" hittest="false">
				<Label id="champions_league_start_timer_text" text="arena_prebattle_text" hittest="false"/>
				<Label id="champions_league_start_timer" text="0:00" hittest="false"/>
			</Panel>
		</snippet>
		<snippet name="black_mask">
			<Panel class="black-mask">
			</Panel>
		</snippet>
		<snippet name="arena_battle">
			<Panel class="arena_battle_container" hittest="false">
				<Panel class="arena_battle_timer_container" hittest="false">
					<Label id="arena_battle_timer" text="0:00" hittest="false"/>
					<Label id="crowd_size" text="crowd_size_text" hittest="false"/>
				</Panel>
				<Panel id="skip_button_container">
					<Button id="skip_button">
						<Label id="skip_button_label" text="skip_button_label"></Label>
					</Button>
				</Panel>
				<Panel class="fighter_health_and_crowd" hittest="false">
					<Panel id="left-battle-info" hittest="false">
						<Label id="left-fighter-name" class="arena-fighter-name" hittest="false"/>
						<Panel id="left-fighter-health-bar-outer" class="arena-health-bar-outer" hittest="false">
							<Panel id="left-right-health" class="arena-health-bar-inner" hittest="false">
							</Panel>
						</Panel>
						<Panel id="left-fighter-crowd-bar-outer" class="arena-crowd-bar-outer" hittest="false">
							<Panel id="left-right-crowd" class="arena-crowd-bar-inner" hittest="false">
							</Panel>
							<Label id="left-crowd-label" class="crowd-label crowd-label-left-margin" hittest="false"/>
							<Label id="left-crowd-label-number" class="crowd-label-number crowd-label" hittest="false"/>
						</Panel>
						<Panel id="left-bo-container" class="bo-container" hittest="false">
							<Panel id="left-bo1" class="bo bo_left" hittest="false">
							</Panel>
							<Panel id="left-bo2" class="bo bo_left" hittest="false">
							</Panel>
							<Panel id="left-bo3" class="bo bo_left" hittest="false">
							</Panel>
						</Panel>
					</Panel>
					<Panel id="right-battle-info" hittest="false">
						<Label id="right-fighter-name" class="arena-fighter-name" hittest="false"/>
						<Panel id="right-fighter-health-bar-outer" class="arena-health-bar-outer" hittest="false">
							<Panel id="right-right-health" class="arena-health-bar-inner" hittest="false">
							</Panel>
						</Panel>
						<Panel id="right-fighter-crowd-bar-outer" class="arena-crowd-bar-outer" hittest="false">
							<Panel id="right-right-crowd" class="arena-crowd-bar-inner" hittest="false">
							</Panel>
<!-- 							<Label id="right-crowd-label" class="crowd-label crowd-label-number"/> -->
							<Label id="right-crowd-label-number" class="crowd-label crowd-label-left-margin" hittest="false"/>
						</Panel>
						<Panel id="right-bo-container" class="bo-container" hittest="false">
							<Panel id="right-bo3" class="bo bo_right" hittest="false">
							</Panel>
							<Panel id="right-bo2" class="bo bo_right" hittest="false">
							</Panel>
							<Panel id="right-bo1" class="bo bo_right" hittest="false">
							</Panel>
						</Panel>
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="vs_clash">
			<Panel class="vs_container" hittest="false">
				<Panel id="vs_container_bg" hittest="false">
				</Panel>
				<Panel id="vs_container_bg_white" class="invisible" hittest="false">
				</Panel>
				<Panel id="left_vs_clash" class="vs_clash">
					<DOTAHeroImage id="left_hero_image"/>
					<Panel id="left_name_bg"></Panel>
					<Label id="left_vs_name_label" class="vs_name_label" text="" hittest="false"/>
				</Panel>
				<Panel id="right_vs_clash" class="vs_clash">
					<DOTAHeroImage id="right_hero_image"/>
					<Panel id="right_name_bg"></Panel>
					<Label id="right_vs_name_label" class="vs_name_label" text="" hittest="false"/>
				</Panel>
				<Label id="vs_message" text="vs" class="invisible" hittest="false"/>
			</Panel>
		</snippet>
		<snippet name="champions_league_loss">
			<Panel class="champions_league_loss_container">
				<Panel id="vs_container_bg" hittest="false">
				</Panel>
				<Panel id="champions_league_flow">
					<Label id="champions_league_outcome_message" hittest="false"/>
					<DOTAHeroImage id="league_hero_image"/>
					<Label id="champions_league_outcome_name" hittest="false"/>
					<Panel id="champions_data_container">
						<Panel id="champions_left_container">
							<Label id="champions_league_time_bonus" class="champions_data_label invisible" hittest="false"/>
							<Label id="champions_league_style_bonus" class="champions_data_label invisible" hittest="false"/>
							<Label id="champions_league_total_bonus" class="champions_data_label invisible total_label" hittest="false"/>
						</Panel>
						<Panel id="champions_right_container">
							<Label id="champions_league_time_bonus_value" class="champions_data_label invisible" hittest="false"/>
							<Label id="champions_league_style_bonus_value" class="champions_data_label invisible" hittest="false"/>
							<Label id="champions_league_total_bonus_value" class="champions_data_label invisible total_label" hittest="false"/>
						</Panel>
					</Panel>
					<Panel id="champions_league_rank_box">
						<Label id="champions_league_rank" class="invisible" hittest="false"/>
						<Image id="rank-up-arrow" class="invisible" src="file://{images}/custom_game/ui/up-arrow.png" />
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="pit_terminal">
			<Panel class="arena_terminal_container" hittest="false">
				<Panel class="terminal_main_bg" hittest="false">
				</Panel>
				<Panel id="terminal_content" hittest="false">
					<Panel id="terminal_header" hittest="false">
						<Label id="terminal_header_text" text="dialogue_name" hittest="false"></Label>
					</Panel>
					<Panel id="left_terminal" hittest="false">
						<Panel id="hero_portrait" hittest="false"></Panel>
						<Label id="hero_name_text" text="dialogue_name" hittest="false"></Label>
						<Panel id="rank_box_for_pit" hittest="false">
							<Panel id="pit_player_info_row_1" class="pit_player_info_row">
								<Label id="pit_level_label" class="pit_player_info_text" text="tooltip_pit_highest_level" hittest="false"/>
								<Label id="pit_level_value" class="pit_player_info_text" text="0" hittest="false"/>
							</Panel>
							<Panel id="pit_player_info_row_2" class="pit_player_info_row">
								<Label id="pit_lockout_label" class="pit_player_info_text" text="tooltip_no_lock_out" hittest="false" html="true"/>
							</Panel>
						</Panel>

					</Panel>
					<Panel id="right_terminal" hittest="false">
						<Panel id="right_terminal_column_a" class="invisible">
							<Label id="wins_label" class="terminal_text" text="terminal_high_score" hittest="false"/>
							<Panel class="horizontal-space"></Panel>
							<Label id="fame_label" class="terminal_text" text="terminal_opponent_rank" hittest="false"/>
						</Panel>
						<Panel id="right_terminal_column_b" class="invisible">
							<Label id="wins_value" class="terminal_text" text="0" hittest="false"/>
							<Panel class="horizontal-space"></Panel>
							<Label id="fame_value" class="terminal_text" text="0" hittest="false"/>
						</Panel>
						<Panel id="pit_data_container">
							<Label id="enemy_name_text" text="terminal_opponent_unselected" hittest="false"></Label>
							<Panel id="pit_enemy_data_row_1" class="pit_enemy_data_row invisible" hittest="false">
								<Label id="enemy_attack_damage_label" text="damage_label" hittest="false" class="enemy_label"></Label>
								<Label id="enemy_attack_damage_value" text="0" hittest="false" class="enemy_label_value"></Label>
							</Panel>
							<Panel id="pit_enemy_data_row_2" class="pit_enemy_data_row invisible" hittest="false">
								<Label id="enemy_resistance_label" text="damage_label" hittest="false" class="enemy_label"></Label>
								<Label id="enemy_resistance_value" text="0" hittest="false" class="enemy_label_value"></Label>
							</Panel>
							<Panel id="pit_enemy_data_row_3" class="pit_enemy_data_row invisible" hittest="false">
								<Label id="enemy_paragon_label" text="damage_label" hittest="false" class="enemy_label"></Label>
								<Label id="enemy_paragon_value" text="0" hittest="false" class="enemy_label_value"></Label>
							</Panel>
						</Panel>
						<Panel id="pit_difficulty_container">
							<Label id="pit_difficulty_label" text="tooltip_select_pit_level_title" hittest="false"/>
							<Panel id="pit_stars_row" hittest="false">
								<Label id="pit_star_1" text="★" hittest="true" class="pit_star"/>
								<Label id="pit_star_2" text="★" hittest="true" class="pit_star"/>
								<Label id="pit_star_3" text="★" hittest="true" class="pit_star"/>
								<Label id="pit_star_4" text="★" hittest="true" class="pit_star"/>
								<Label id="pit_star_5" text="★" hittest="true" class="pit_star"/>
								<Label id="pit_star_6" text="★" hittest="true" class="pit_star"/>
								<Label id="pit_star_7" text="★" hittest="true" class="pit_star"/>
							</Panel>
						</Panel>
						<Panel id="champions_league_start_button">
							<Label id="champions_league_start_button_label" text="start_champions_league_battle" hittest="false"/>
						</Panel>
					</Panel>
					<Panel id="opponent_select_box">
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="quest_log">
			<Panel class="quest_log_container" hittest="false">

				<Panel class="quest_log_bg" hittest="false">
				</Panel>
				<Button id="quest_close_button"
					onactivate="closeQuestLog()">
					<Label id="close_quest_text" html="true" hittest="false" text="ui_close_panel"></Label>
				</Button>
				<Panel class="quest_log" hittest="false">
					<Panel id="quest_log_title_container" hittest="false">
						<Label id="quest_log_title" hittest="false"/>
						<Label id="quest_log_title_b" hittest="false"/>
						<Panel id="active_complete_container">
							<Button id="quest_active_button" class="quest_state_button"
								onactivate="toggleQuestState(0)">
								<Label class="quest_state_label" html="true" hittest="false" text="tooltip_active"></Label>
							</Button>
							<Button id="quest_completed_button" class="quest_state_button"
								onactivate="toggleQuestState(1)">
								<Label class="quest_state_label" html="true" hittest="false" text="tooltip_completed"></Label>
							</Button>
						</Panel>
						<Label id="quest_log_no_quests" hittest="false"/>
					</Panel>
					<Panel id="quest_list" hittest="false">
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="quest_item">
			<Panel class="quest-item-container" hittest="false">
				<Panel id="quest_item_bg" class="quest_item_bg_incomplete">
				</Panel>
				<Panel id="quest-item-inner-container" hittest="false">
					<Image id="quest-item-image" hittest="false"></Image>
					<Panel id="quest-item-description" hittest="false">
						<Label id="quest-title" hittest="false" html="true"></Label>
						<Label id="quest-description" html="true" hittest="false"></Label>
					</Panel>
					<Panel id="quest-item-progress" hittest="false">
						<Label id="quest-progress" hittest="false" text="tooltip_progress"></Label>
						<Label id="quest-progress-values" html="true" hittest="false"></Label>
					</Panel>
					<Panel id="quest-item-reward" hittest="false">
						<Label id="quest-reward" hittest="false" text="tooltip_reward"></Label>
						<Image id="quest-reward-image" src="" 
						onmouseout="HideQuestlogRewardTooltip()"/>
					</Panel>
				</Panel>
			</Panel>
		</snippet>	
		<snippet name="donations_board">
				<Panel class="arena_scoreboard" hittest="false">
					<Panel class="arena_scoreboard_bg" hittest="false">
					</Panel>
					<Panel id="leadboard_title">
						<Panel class="arena_leaderboard_title_bg" hittest="false">
						</Panel>
						<Label id="leaderboard_title_text" text="https://www.roshpit.ca/donate" hittest="false"></Label>
					</Panel>
<!-- 					<Label id="donation-tip-text" text="roshpit.ca/donate&lt;a href=&quot;https://roshpit.ca/donate&quot;&gt;&lt;a&gt;" hittest="true" html="true"></Label> -->
					<Panel id="leaderboard-leaders-box" class="donations-content-box">
					</Panel>
				</Panel>
		</snippet>
		<snippet name="donation_item">
			<Panel class="donation_item_container" hittest="false">
				<Panel id="top-info-box">
					<Panel id="left-info">
						<Label id="donation_name" text="name text" hittest="false"></Label>
						<Label id="donation_date" text="date text" hittest="false"></Label>
					</Panel>
					<Panel id="right-info">
						<Label id="donation_amount" text="AMOUNT" hittest="false"></Label>
					</Panel>
				</Panel>
				<Panel id="bottom-info-box">
					<Label id="donation_message" text="MESSAGE" hittest="false"></Label>
				</Panel>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="arena_content" hittest="false">
		<Panel id="arena_container" hittest="false">

		</Panel>
		<Panel id="arena_battle_container" hittest="false">

		</Panel>
		<Panel id="arena_fade_container" hittest="false">

		</Panel>
	</Panel>
</root>
