<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/quests/quests.css" />
		<include src="file://{resources}/styles/custom_game/menu/menu.css" />
		<include src="file://{resources}/styles/custom_game/npc_dialogue.css" />
		<include src="file://{resources}/styles/custom_game/resources/blacksmith.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/npc_dialogue_re.js" />
		<include src="file://{resources}/scripts/custom_game/heroes_custom/heroes_custom.js" />
	</scripts>
	<snippets>
		<snippet name="supplies_dealer">
			<Panel class="supplies_dealer_root" hittest="false">
				<Panel id="header_image_container">
					<Image id="header_image" src="file://{images}/custom_game/ui/supplies_dealer.jpg"/>
					<Label id="header_text" text="supplies_dealer" html="true"></Label>
				</Panel>

				<Panel id="supplies_dealer_content">
					<Label id="potion_row_1_title" class="potion_row_title" text="supplies_attack_damage"/>
					<Panel id="supplies_potion_row_1">

					</Panel>
					<Label id="potion_row_2_title" class="potion_row_title" text="supplies_ability_damage"/>
					<Panel id="supplies_potion_row_2">

					</Panel>
					<Label id="potion_row_3_title" class="potion_row_title" text="supplies_vitality"/>
					<Panel id="supplies_potion_row_3">

					</Panel>
				</Panel>
				<Button class="main_menu_button" id="close_npc_dialogue" hittest="true">
					<Label id="close_button_label" class="menu_button_text" text="Close">
					</Label>			
				</Button>
			</Panel>
		</snippet>
		<snippet name="supplies_potion">
			<Panel class="supplies_potion_root" hittest="false">
				<Button id="supplies_potion_button" hittest="true">
					<Image id="potion_image" src="file://{images}/items/potions/ability_potion_1.png"/>
				</Button>
				<Panel id="price_container_bg" hittest="false">
				</Panel>	
				<Panel id="price_container">
					<Image class="item_gold_price_image" src="file://{images}/custom_game/ui/gold_icon.png" />
					<Label class="item_price_text" id="item_price_text" text="10,000" html="true"></Label>	

				</Panel>

			</Panel>
		</snippet>
		<snippet name="curator">
			<Panel class="curator_root" hittest="false">
				<Panel id="curator_main_container" hittest="false">
					<Panel id="curator_container" hittest="false">
						<Panel id="header_image_container_curator">
							<Image id="header_image_curator" src="file://{images}/custom_game/ui/curator_header.jpg"/>
							<Label id="header_text" text="the_curator" html="true"></Label>
						</Panel>
						<Label id="glyph_loading_label" class="menu_button_text">
						</Label>
						<Panel id="curator_content">
							<Panel id="curate_tip_container">
								<Label id="curate_tip1" text="curate_tip1" html="true"></Label>
							</Panel>	
							<Panel id="chisel_button_container">
								<Button id="chisel_button" hittest="true"
									onactivate='CurateItemActivate()'>
									<Label id="chisel_button_label" class="menu_button_text" text="curator_button1">
									</Label>			
								</Button>						
							</Panel>

							<Panel id="curator-item-display-box" hittest="true">
								<Panel id="item-display-box-bg" hittest="true">
								</Panel>
								<Panel id="item-display-content" hittest="true">
								</Panel>
							</Panel>

							<Panel id="final_curate_button_container" class="invisible">
								<Button id="final_forge_button" class="forge_button_color_main" hittest="true"
									onactivate='FinalCurateActivate()'>
									<Label id="final_forge_button_label" class="menu_button_text" text="curator_button_final">
									</Label>			
								</Button>						
							</Panel>
						</Panel>
						<Button class="main_menu_button" id="close_blacksmith_shop" hittest="true"
							onactivate='CloseCurator()'>
							<Label id="close_button_label" class="menu_button_text" text="Close">
							</Label>			
						</Button>
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="curator_item_blacksmith">
			<Panel class="item_detail_blacksmith_root" hittest="false">
					<DOTAItemImage hittest="true" id="item_image"/>
						<Label id="item_name" text="item_name" html="true">
						</Label>	
					<Panel id="item_properties_container">
					</Panel>		
					<Panel id="min_level_container">
						<Label id="min_level_label" text="item_name" html="true"></Label>
						<Label id="min_level_label_value" text="item_name" html="true"></Label>
					</Panel>	
					<Panel id="forge_price_container">
						<Label id="forge_price_label" text="item_name" html="true"></Label>
						<Panel id="forge_price_box_container" hittest="false">
							<Image id="forge_price_image" src="file://{images}/custom_game/ui/mithril_shard.png" />
							<Label id="forge_price_label_value" text="" html="true"></Label>
						</Panel>
					</Panel>				
			</Panel>
		</snippet>
		<snippet name="curate_pre_screen">
			<Panel class="curate_prescreen_root" hittest="false">
					<Panel id="curate_tip_container">
						<Label id="reroll_other_tip" text="curate_tip" html="true"></Label>
					</Panel>		
					<DOTAItemImage hittest="true" id="item_image" class="white_glow"/>
						<Label id="item_placement_tip" text="" html="true">
						</Label>	
					<Panel id="item_property1" class="item_property_curate"></Panel>
					<Panel id="item_property2" class="item_property_curate"></Panel>
					<Panel id="item_property3" class="item_property_curate"></Panel>
					<Panel id="item_property4" class="item_property_curate"></Panel>
			</Panel>
		</snippet>
		<snippet name="curator_item_row">
			<Panel class="blacksmith_attribute_row" hittest="true">
				<Label id="property_name" text="item_name" html="true">
				</Label>	
				<Label id="property_value" text="0" html="true">
				</Label>								
			</Panel>
		</snippet>
	</snippets>
	<Panel class="npc_dialogue_root" hittest="false">
		<Panel id="npc_dialogue_container" hittest="false">

		</Panel>
		<Panel id="npc_dialogue_big" hittest="false">
		</Panel>
	</Panel>
</root>
