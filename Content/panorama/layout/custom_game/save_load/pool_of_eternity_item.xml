<root>
	<styles>
		<include src="file://{resources}/styles/dotastyles.css" />
		<include src="file://{resources}/styles/custom_game/save_load/save_load.css" />
		<include src="file://{resources}/styles/custom_game/tooltips.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/save_load/stash_item.js" />
		<include src="file://{resources}/scripts/custom_game/equipment/item_tooltip.js" />
		<include src="file://{resources}/scripts/custom_game/heroes_custom/heroes_custom.js" />
	</scripts>
	<Panel class="ItemPanel" draggable="true">
		<Button id="ItemButton"
				onmouseover="ItemShowTooltip('#ItemImage')"
				onmouseout="ItemHideTooltip('#ItemImage')"
				>
			<DOTAItemImage hittest="false" id="ItemImage" class="inventory-item-image" />>
			<Panel hittest="false" id="DropTargetHighlight" />
		</Button>
	</Panel>
</root>
