<root>
	<styles>
		<include src="file://{resources}/styles/dotastyles.css" />
		<include src="file://{resources}/styles/custom_game/equipment.css" />
		<include src="file://{resources}/styles/custom_game/tooltips.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/swap_ui.js" />
	</scripts>
	<Panel class="full_swap_hud">
		<Panel id="full_swap_container"
			onload="InitializeSwapPanels()">
			<Panel class="equipment_swap_panel">
				<Panel class="large_equipment_panel" id="large_equipment_panel">
				<Image class="equipment_panel_image_swap" src="file://{images}/custom_game/ui/large_panel2.png" />
					<Panel class="swap_item_container" id="swap_item_container" draggable="false">
						<Panel class="swap_item_contents" draggable="false">
							<Label class="swap_item_title" text="Equipped"></Label>
							<DOTAItemImage hittest="false" class="ItemImageSwap" id="ItemImageSwap" draggable="true"/>
							<Label class="swap_item_name" id="swap_item_name1" text="Item Name" html="true"></Label>
							<Label class="swap_item_property1name" id="swap_item_property1name1" text="Property" html="true"></Label>
							<Label class="swap_item_property1value" id="swap_item_property1value1" text="0" html="true"></Label>
							<Label class="swap_item_property2name" id="swap_item_property2name1" text="Property" html="true"></Label>
							<Label class="swap_item_property2value" id="swap_item_property2value1" text="0" html="true"></Label>	
							<Label class="swap_item_property3name" id="swap_item_property3name1" text="Property" html="true"></Label>
							<Label class="swap_item_property3value" id="swap_item_property3value1" text="0" html="true"></Label>	
							<Label class="swap_item_property4name" id="swap_item_property4name1" text="Property" html="true"></Label>
							<Label class="swap_item_property4value" id="swap_item_property4value1" text="0" html="true"></Label>	
							<Label class="swap_item_property5name" id="swap_item_property5name1" text="Property" html="true"></Label>
							<Label class="swap_item_property5value" id="swap_item_property5value1" text="0" html="true"></Label>
						</Panel>	
						<Button class="swap_button" id="keep_old"
							onactivate="KeepOld()"
							>
						

							<Image class="swap_button_image" src="file://{images}/custom_game/ui/narrow_panel2.png" />
							<Label class="button_label" id="keep_equipped_label" text="Keep Equipped" />
						</Button>
					</Panel>
				</Panel>
			</Panel>
			<Panel class="equipment_swap_panel2">
				<Panel class="large_equipment_panel" id="large_equipment_panel">
				<Image class="equipment_panel_image_swap" src="file://{images}/custom_game/ui/large_panel2.png" />
					<Panel class="swap_item_container" id="swap_item_container" draggable="false">
						<Panel class="swap_item_contents" draggable="false">
							<Label class="swap_item_title" text="New"></Label>
							<DOTAItemImage hittest="false" class="ItemImageSwap" id="ItemImageSwap2" draggable="true"/>
							
							<Label class="swap_item_name" id="swap_item_name2" text="Item Name" html="true"></Label>
							<Label class="swap_item_property1name" id="swap_item_property1name2" text="Property" html="true"></Label>
							<Label class="swap_item_property1value" id="swap_item_property1value2" text="0" html="true"></Label>
							<Label class="swap_item_property2name" id="swap_item_property2name2" text="Property" html="true"></Label>
							<Label class="swap_item_property2value" id="swap_item_property2value2" text="0" html="true"></Label>	
							<Label class="swap_item_property3name" id="swap_item_property3name2" text="Property" html="true"></Label>
							<Label class="swap_item_property3value" id="swap_item_property3value2" text="0" html="true"></Label>	
							<Label class="swap_item_property4name" id="swap_item_property4name2" text="Property" html="true"></Label>
							<Label class="swap_item_property4value" id="swap_item_property4value2" text="0" html="true"></Label>	
							<Label class="swap_item_property5name" id="swap_item_property5name2" text="Property" html="true"></Label>
							<Label class="swap_item_property5value" id="swap_item_property5value2" text="0" html="true"></Label>
						</Panel>
						<Button class="swap_button" id="take_new"
							onactivate="TakeNew()"
							>
							<Image class="swap_button_image" src="file://{images}/custom_game/ui/narrow_panel2.png" />
							<Label class="button_label" id="equip_new_label" text="Equip New Item" />
						</Button>
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>

</root>
