<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/heroes_special/omniro.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/elements/elements.js" />
		<include src="file://{resources}/scripts/custom_game/heroes_special/omniro_tooltip.js" />
	</scripts>
	<Panel class="omniro_tooltip_root" ontooltiploaded="initialize_omniro_tooltip()">
		<Panel id="omniro_tooltip_bg"/>
		<Panel id="omniro_tooltip_content">
			<Label id="omniro_element_tooltip_title" html="true"/>	
			<Label id="omniro_element_tooltip_level" html="true"/>	
			<Label id="omniro_element_help" html="true"/>
			<Panel id="omniro_omnimace_content">
				<Label id="omniro_omnimace_title"/>
				<Label id="omniro_omnimace_effect_description"/>

				<Panel class="omniro_element_property_content invisible" id="omniro_content_1">
					<Label id="omniro_omnimace_special_property1"/>
					<Label id="omniro_omnimace_special_property1_value" html="true"/>
				</Panel>
				<Panel class="omniro_element_property_content invisible" id="omniro_content_2">
					<Label id="omniro_omnimace_special_property2"/>
					<Label id="omniro_omnimace_special_property2_value" html="true"/>
				</Panel>
			</Panel>
		</Panel>

	</Panel>


</root>
