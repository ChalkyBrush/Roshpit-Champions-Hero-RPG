<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/hero/hero_stats.css" />
  </styles>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/hero_stats.js" /> 
  </scripts>
  <Panel hittest="false" class="hero_stats_root">
    <Panel id="unit_stats_container" hittest="false">
      <Panel id="unit_attributes" hittest="false">
        <Panel class="unit_attributes_row" id="unit_attributes_top_row" hittest="false">
          <Panel class="unit_attribute" hittest="false">
            <Image id="unit_attribute_armor" class="unit_attribute_image" hittest="false"/>
            <Label id="unit_attribute_armor_label" class="unit_attribute_label" text="12999" hittest="false"/>
          </Panel>
          <Panel class="unit_attribute" hittest="false">
            <Image id="unit_attribute_armor_pierce" class="unit_attribute_image" hittest="false"/>
            <Label id="unit_attribute_armor_pierce_label" class="unit_attribute_label" text="1000" hittest="false"/>
          </Panel>
        </Panel>
        <Panel class="unit_attributes_row" id="unit_attributes_bottom_row" hittest="false">
          <Panel class="unit_attribute" hittest="false">
            <Image id="unit_attribute_magic_armor" class="unit_attribute_image" hittest="false"/>
            <Label id="unit_attribute_magic_armor_label" class="unit_attribute_label" text="844" hittest="false"/>
          </Panel>
          <Panel class="unit_attribute" hittest="false">
            <Image id="unit_attribute_spell_pierce" class="unit_attribute_image" hittest="false"/>
            <Label id="unit_attribute_spell_pierce_label" class="unit_attribute_label" text="1000" hittest="false"/>
          </Panel>
        </Panel>
      </Panel>

      <Panel id="hero_attributes">

          <Panel class="attribute_data">
            <Label class="hero_attribute_label" id="strength_label" text="2400"/>
            <Panel id="Hero_Strength_Icon"/>
          </Panel>
          <Panel class="attribute_data">
            <Label class="hero_attribute_label" id="agility_label"  text="240"/>
            <Panel id="Hero_Agility_Icon"/>
          </Panel>
          <Panel class="attribute_data">
            <Label class="hero_attribute_label" id="intelligence_label"  text="210"/>
            <Panel id="Hero_Intelligence_Icon"/>
          </Panel>
          <Panel class="attribute_data">
            <Label class="hero_attribute_label" id="spirit_label"  text="2500"/>
            <Panel id="Hero_Spirit_Icon"/>
          </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>

    

