<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/custom_attributes.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/skills/attribute_tooltip.js" />
	</scripts>
	<Panel class="item_tooltip_new_root" ontooltiploaded="initializeTooltip()">
		<Panel id="tooltip_main_container" class="master_attribute_container">
			<Panel id="tooltip_title_container">
				<Label id="tooltip_title" text="UnitName" html="true"/>
				<Label id="tooltip_level" text="Lv" html="true"/>
			</Panel>
			<Panel class="class-splitter">
			</Panel>
			<Panel id="attributes_main_container">
				<Panel class="attribute_container" id="container_strength">
					<Panel class="attribute_header">
						<Image src="s2r://panorama/images/hud/pip_str_png.vtex" class="attribute_image" id="attribute_image_strength">
						</Image>
						<Panel class="attribute_title_and_value_container">
							<Label class="attribute_title" id="attribute_title_strength"/>
							<Label class="attribute_value" id="attribute_value_strength"/>
						</Panel>
					</Panel>
					<Panel class="class-splitter-thin">
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_str_1_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_str_1_right" html="true"/>
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_str_2_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_str_2_right" html="true"/>
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_str_3_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_str_3_right" html="true"/>
					</Panel>
				</Panel>
				<Panel class="attribute_container" id="container_agility">
					<Panel class="attribute_header">
						<Image src="s2r://panorama/images/hud/pip_agi_png.vtex" class="attribute_image" id="attribute_image_agility">
						</Image>
						<Panel class="attribute_title_and_value_container">
							<Label class="attribute_title" id="attribute_title_agility"/>
							<Label class="attribute_value" id="attribute_value_agility"/>
						</Panel>
					</Panel>	
					<Panel class="class-splitter-thin">
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_agi_1_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_agi_1_right" html="true"/>
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_agi_2_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_agi_2_right" html="true"/>
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_agi_3_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_agi_3_right" html="true"/>
					</Panel>				
				</Panel>
				<Panel class="attribute_container" id="container_int">
					<Panel class="attribute_header">
						<Image src="s2r://panorama/images/hud/pip_int_png.vtex" class="attribute_image" id="attribute_image_int">
						</Image>
						<Panel class="attribute_title_and_value_container">
							<Label class="attribute_title" id="attribute_title_int"/>
							<Label class="attribute_value" id="attribute_value_int"/>
						</Panel>
					</Panel>	
					<Panel class="class-splitter-thin">
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_int_1_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_int_1_right" html="true"/>
					</Panel>
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_int_2_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_int_2_right" html="true"/>
					</Panel>	
					<Panel class="attribute_given_bonus_container">
						<Label class="attribute_given_bonus bonus_left" id="attribute_given_bonus_int_3_left" html="true"/>
						<Label class="attribute_given_bonus bonus_right" id="attribute_given_bonus_int_3_right" html="true"/>
					</Panel>				
				</Panel>
			</Panel>
			<Panel class="attack_defense_container">
				<Panel class="attack_defense_panel">
					<Label class="attack_defense_title" id="attack_defense_title_atk"/>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="atk_1_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="atk_1_right" html="true"/>
					</Panel>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="atk_2_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="atk_2_right" html="true"/>
					</Panel>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="atk_3_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="atk_3_right" html="true"/>
					</Panel>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="atk_4_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="atk_4_right" html="true"/>
					</Panel>
					<Panel class="class-splitter-thin-full">
					</Panel>
					<Label class="attack_defense_subtitle" id="attack_defense_subtitle_base_ability"/>
					<Panel class="resistance_container">
						<Panel class="base_ability_item_container">
							<Label class="resistance_title" id="base_ability_title_q" html="true"/>
							<Label class="resistance_value" id="base_ability_value_q"/>
						</Panel>
						<Panel class="base_ability_item_container">
							<Label class="resistance_title" id="base_ability_title_w" html="true"/>
							<Label class="resistance_value" id="base_ability_value_w"/>
						</Panel>
						<Panel class="base_ability_item_container">
							<Label class="resistance_title" id="base_ability_title_e" html="true"/>
							<Label class="resistance_value" id="base_ability_value_e"/>
						</Panel>
						<Panel class="base_ability_item_container">
							<Label class="resistance_title" id="base_ability_title_r" html="true"/>
							<Label class="resistance_value" id="base_ability_value_r"/>
						</Panel>
					</Panel>
				</Panel>
				<Panel class="attack_defense_panel panel_right">
					<Label class="attack_defense_title" id="attack_defense_title_def"/>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="def_1_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="def_1_right" html="true"/>
					</Panel>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="def_2_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="def_2_right" html="true"/>
					</Panel>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="def_3_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="def_3_right" html="true"/>
					</Panel>
					<Panel class="atk_def_property_container">
						<Label class="atk_def_property bonus_left" id="def_4_left" html="true"/>
						<Label class="atk_def_property bonus_right" id="def_4_right" html="true"/>
					</Panel>
					<Panel class="class-splitter-thin-full">
					</Panel>
					<Label class="attack_defense_subtitle" id="attack_defense_subtitle_resist"/>
					<Panel class="resistance_container">
						<Panel class="resistance_item_container">
							<Label class="resistance_title" id="resist_title_phys" html="true"/>
							<Label class="resistance_value" id="resist_value_phys"/>
						</Panel>
						<Panel class="resistance_item_container">
							<Label class="resistance_title" id="resist_title_magic" html="true"/>
							<Label class="resistance_value" id="resist_value_magic"/>
						</Panel>
						<Panel class="resistance_item_container">
							<Label class="resistance_title" id="resist_title_pure" html="true"/>
							<Label class="resistance_value" id="resist_value_pure"/>
						</Panel>
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>


</root>
