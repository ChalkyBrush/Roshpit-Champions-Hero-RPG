						<Label class="shop_rarity_button_text" id="mythical_button_text" text="Mythical" html="true"></Label>
					</Button>
				</Panel>


			</Panel>
			<Panel id="close_button">
					<Image class="close_button_image" src="file://{images}/custom_game/ui/narrow_panel2.png" />
					<Button class="close_button"
						onactivate='ClosePanel()'
						>
						<Label class="close_button_text" text="Close" html="true"></Label>
					</Button>
			</Panel>
			<Panel id="click_rarity_notification">
