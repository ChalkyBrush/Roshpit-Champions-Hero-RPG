	<Panel hittest="false" class="root_shop_panel">
		<Panel id="root_shop_panel_inner">
			<Panel class="shop_background">
			</Panel>
			<Panel class="shop_title">
				<Label class="shop_title_text" id="shop_title_text" text="Gheed's Gambling Post"></Label>
			</Panel>
			<Panel class="rarity_button_container">
				<Panel class="individual_rarity_button_panel" id="uncommon_panel">
					<Image class="rarity_panel_button_image" src="file://{images}/custom_game/ui/narrow_panel2.png" />
					<Button class="rarity_button"
						onactivate='select_rarity("uncommon")'
						>
						<Label class="shop_rarity_button_text" id="uncommon_button_text" text="Uncommon" html="true"></Label>
					</Button>
				</Panel>

				<Panel class="individual_rarity_button_panel" id="rare_panel">
					<Image class="rarity_panel_button_image" src="file://{images}/custom_game/ui/narrow_panel2.png" />
