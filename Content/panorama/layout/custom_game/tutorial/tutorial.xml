<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/tutorial/tutorial.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/tutorial/tutorial.js" />
	</scripts>
	<snippets>
		<snippet name="tutorial_main">
			<Panel class="tutorial_main" hittest="false">
				<Panel id="tutorial_bg" hittest="false"/>
				
				<Panel class="tutorial_mega_container">	
					<Image id="tutorial_header" hittest="false">
						<Panel id="tutorial_header_container" hittest="false">
							<Panel id="tutorial_header_container_bg" hittest="false"></Panel>
							<Label id="tutorial_header_title" text="tutorial_menu_title" hittest="false"/>
						</Panel>
					</Image>
					<Panel id="tutorial_categories_container">
					</Panel>
					<Button id="close_button">
						<Label id="close_button_label" text="ui_close"/>
					</Button>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="tutorial_category">
			<Panel class="tutorial_category" hittest="false">
				<Button id="tutorial_category_clickable">
					<Panel class="tutorial_category_bg" hittest="false"/>
					<Panel class="tutorial_category_container">
						<Panel class="tutorial_category_header" id="tutorial_category_header">
							<Label id="tutorial_category_header_label"/>
						</Panel>
						<Panel class="tutorial_category_description" id="tutorial_category_description">
							<Label id="tutorial_category_description_label"/>
						</Panel>
					</Panel>
				</Button>
			</Panel>
		</snippet>
		<snippet name="tutorial_challenge_list">
			<Panel class="tutorial_challenge_list" hittest="false">

			</Panel>
		</snippet>
		<snippet name="tutorial_challenge">
			<Panel class="tutorial_challenge" hittest="false">
				<Button id="challenge_button">
					<Label id="tutorial_challenge_text"/>
				</Button>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="tutorial_content" hittest="false">
		<Panel id="tutorial_container" hittest="false">

		</Panel>
	</Panel>
</root>
