<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/tutorial/tutorial.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/tutorial/tutorial.js" />
	</scripts>
	<snippets>
		<snippet name="tutorial_main">
			<Panel class="tutorial_main" hittest="false">
				<Panel id="tutorial_bg" hittest="false"/>
				
				<Panel class="tutorial_mega_container">	
					<Image id="tutorial_header" hittest="false">
						<Panel id="tutorial_header_container" hittest="false">
							<Panel id="tutorial_header_container_bg" hittest="false"></Panel>
							<Label id="tutorial_header_title" text="tutorial_menu_title" hittest="false"/>
						</Panel>
					</Image>
					<Panel id="tutorial_categories_container">
					</Panel>
					<Button id="close_button">
						<Label id="close_button_label" text="ui_close"/>
					</Button>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="tutorial_category">
			<Panel class="tutorial_category" hittest="false">
				<Button id="tutorial_category_clickable">
					<Panel class="tutorial_category_bg" hittest="false"/>
					<Panel class="tutorial_category_container">
						<Panel class="tutorial_category_header" id="tutorial_category_header">
							<Label id="tutorial_category_header_label" html="true"/>
						</Panel>
						<Panel class="tutorial_category_description" id="tutorial_category_description">
							<Label id="tutorial_category_description_label"/>
						</Panel>
					</Panel>
				</Button>
			</Panel>
		</snippet>
		<snippet name="tutorial_challenge_list">
			<Panel class="tutorial_challenge_list" hittest="false">
				<Panel id="total_challenge_list" hittest="false">
					<Panel id="challenge_list_items" hittest="false">
					</Panel>
					<Panel id="challenge_description_and_go_container" hittest="false">
					</Panel>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="tutorial_challenge">
			<Panel class="tutorial_challenge" hittest="false">
				<Button id="challenge_button">
					<Label id="tutorial_challenge_text"/>
					<Image id="green_check" class="invisible" src="file://{images}/custom_game/ui/green_check.png"/>
				</Button>
			</Panel>
		</snippet>
		<snippet name="reward_and_go">
			<Panel class="challenge_description_and_go" hittest="false">
				<Panel id="reward_and_go_content" class="animateEaseClass">
					<Image id="reward_image" src="file://{images}/spellicons/tutorial/reward1.png"/>
					<Label id="reward_and_go_description_text"/>
					<Button id="reward_go_button" class="reward_unclaimed">
						<Label id="challenge_go_button_text"/>
					</Button>					
				</Panel>
			</Panel>
		</snippet>
		<snippet name="challenge_description_and_go">
			<Panel class="challenge_description_and_go" hittest="false">
				<Panel id="descrip_and_go_content" class="animateEaseClass">
					<Label id="descrip_and_go_description_text"/>
					<Button id="challenge_go_button">
						<Label id="challenge_go_button_text"/>
					</Button>					
				</Panel>
			</Panel>
		</snippet>
		<snippet name="challenge_summary">
			<Panel class="challenge_summary" hittest="false">
			</Panel>
		</snippet>
		<snippet name="challenge_summary_item">
			<Panel class="challenge_summary_item" hittest="false">
				<Panel class="challenge_summary_bg">
				</Panel>
				<Label id="challenge_summary_item_label" hittest="false"/>
			</Panel>
		</snippet>
		<snippet name="quiz_box">
			<Panel class="quiz_box" hittest="false">
				<Panel class="quiz_box_bg"/>
				<Panel class="quiz_box_header">
					<Label id="quiz_box_header_label"/>
				</Panel>
				<Panel class="quiz_box_content">
					<Label class="quiz_box_question" id="quiz_box_question" html="true"/>
					<TextEntry id="quiz_box_input" maxchars="255"/>

					<Button id="quiz_submit_button">
					  <Label text="quiz_submit" class="quiz_submit_label"></Label>
					</Button>					
				</Panel>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="tutorial_content" hittest="false">
		<Panel id="tutorial_container" hittest="false">
		</Panel>
		<Panel id="tutorial_challenge_summary_container" hittest="false">
		</Panel>
		<Panel id="tutorial_quiz_container" hittest="false">
		</Panel>
	</Panel>
</root>
