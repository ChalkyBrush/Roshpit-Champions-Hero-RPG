<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/gems.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/gems/gemforger.js" />
	</scripts>
	<snippets>
		<snippet name="gemforger_main">
			<Panel class="gemforger_main" hittest="false">
				<Panel id="gemforger_bg" hittest="false"/>
				
				<Panel class="gemforger_mega_container">	
					<Image id="gemforger_header" hittest="false">
						<Panel id="gemforger_header_container" hittest="false">
							<Panel id="gemforger_header_container_bg" hittest="false"></Panel>
							<Label id="gemforger_header_title" text="gem_forger" hittest="false"/>
						</Panel>
					</Image>
					<Panel id="gemforger_attach_contents">
					</Panel>
					<Button id="close_button">
						<Label id="close_button_label" text="ui_close"/>
					</Button>
				</Panel>
			</Panel>
		</snippet>
		<snippet name="gemforger_reward">
			<Panel class="gemforger_reward_root" hittest="false">
				<Button id="gemforger_reward_collect" class="gemforger_reward_active" hittest="true">
					<Image id="gemforger_reward_image" hittest="false"/>
					<Panel class="gemforger_reward_text_container" hittest="false">
						<Label id="reward_available_label" text="gem_forger_reward_available" hittest="false"/>
						<Label id="reward_amount_label" text="" hittest="false" html="true"/>
					</Panel>
					<Label id="reward_click" text="ui_click_to_collect" hittest="false" html="true"/>
				</Button>
			</Panel>
		</snippet>
		<snippet name="gemforger_start_button">
			<Panel class="gemforger_start_button_root" hittest="false">
				<Button id="gemforger_start_button_collect" class="gemforger_reward_active" hittest="true">
					<Label id="gem_forger_start_label" text="gem_forger_start" hittest="false" html="true"/>
				</Button>
			</Panel>
		</snippet>

	</snippets>

	<Panel class="gemforger_content" hittest="false">
		<Panel id="gemforger_container" hittest="false">
		</Panel>
	</Panel>
</root>
