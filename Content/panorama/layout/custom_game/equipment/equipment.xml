					</Panel>
				</Panel>
				<Panel class="item_container" id="boot_amulet_main_container" hittest="false">
					<Panel class="item_image" id="boot_container" hittest="true"
						onactivate='EquipmentClick(3)'
						onmouseover="ItemShowTooltipInit(3)"
						onmouseout="ItemHideTooltipInit(3)">
						<DOTAItemImage hittest="false" id="ItemImageBoot"/>

					</Panel>
					<Panel class="item_image" id="amulet_container" hittest="true"
						onactivate='EquipmentClick(5)'
