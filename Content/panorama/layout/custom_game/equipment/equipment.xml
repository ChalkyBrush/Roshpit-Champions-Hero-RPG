<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/menu/equipment.css" />
		<include src="file://{resources}/styles/custom_game/menu/menu.css" />
		<include src="file://{resources}/styles/custom_game/weapons.css" />
		<include src="file://{resources}/styles/custom_game/gems.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/gems/gems_shared.js" />
		<include src="file://{resources}/scripts/custom_game/glyphs/glyphs.js" />
		<include src="file://{resources}/scripts/custom_game/menu/equipment.js" />
		<include src="file://{resources}/scripts/custom_game/equipment_manager.js" />
		<include src="file://{resources}/scripts/custom_game/equipment_item.js" />
		<include src="file://{resources}/scripts/custom_game/equipment/item_tooltip.js" />
	</scripts>
	<snippets>
		<snippet name="equipment_query">
			<Panel class="equipment_query_container" hittest="false">
				<Panel class="equipment_query_bg" hittest="false">
				</Panel>
			</Panel>
		</snippet>
		<snippet name="equipment_item_snippet">
			<Panel class="item_container" hittest="false">
				<Panel class="item_image" id="item_container" hittest="true"
					onactivate='EquipmentClick(0)'
					onmouseover="ItemShowTooltipInit(0)"
					onmouseout="ItemHideTooltipInit(0)">
					<DOTAItemImage hittest="false" id="ItemImage" draggable="true"/>

				</Panel>
			</Panel>
		</snippet>
		<snippet name="gem_snippet">
			<Panel hittest="false" class="invisible gems-root">
				<Panel hittest="false" id="gems-small-socket1" class="gems-small-socket">
					<Image class="placed-gem" id="placed-gem1"/>
				</Panel>
				<Panel hittest="false" id="gems-small-socket2" class="gems-small-socket">
					<Image class="placed-gem" id="placed-gem2"/>
				</Panel>
			</Panel>
		</snippet>
	</snippets>
	<Panel class="main_equipment" hittest="false">
		<Panel id="glyph_parent">
			<Panel id="main_glyph_bg" hittest="false">
			</Panel>
			<Panel id="glyph-line-1" hittest="false">
			</Panel>
			<Panel id="glyph-line-2" hittest="false">
			</Panel>
			<Panel id="glyph-line-3" hittest="false">
			</Panel>
			<Panel id="glyph_container" hittest="false">
				<Label id="glyph_title_label" text="ui_glyphs_title"></Label>
				<Panel id="glyph-row-1" hittest="false">

				</Panel>
				<Panel id="glyph-row-2" hittest="false">

				</Panel>
			</Panel>
		</Panel>
		<Panel id="main_equipment_parent" hittest="false">
			<Panel id="main_equipment_bg" hittest="false">
				<Image id="equipment_doll" src="file://{images}/custom_game/ui/silhouette-white.png" hittest="false"/>
			</Panel>
			<Panel id="main_equipment_container" hittest="false">
				<Panel class="item_container" id="helm_main_container" hittest="false">
					<Panel class="item_image" id="helm_container" hittest="true"
						onactivate='EquipmentClick(0)'
						onmouseover="ItemShowTooltipInit(0)"
						onmouseout="ItemHideTooltipInit(0)">
						<Image hittest="false" id="ImageEmpty" class="inventory-item-image" src="file://{images}/custom_game/items/empty-inventory-slot.png"/>
						<DOTAItemImage hittest="false" id="ItemImageHelm"/>
						<Panel id="gems_container0" class="gems-equipment-container"/>
						<Panel hittest="false" id="Cooldown0" class="Cooldown">
							<Panel hittest="false" id="CooldownOverlay0" class="CooldownOverlay" />
							<Label hittest="false" id="CooldownTimer0" class="CooldownTimer" />
						</Panel>
					</Panel>
				</Panel>
				<Panel class="item_container" id="armor_main_container" hittest="false">
					<Panel class="item_image" id="armor_container" hittest="true"
						onactivate='EquipmentClick(4)'
						onmouseover="ItemShowTooltipInit(4)"
						onmouseout="ItemHideTooltipInit(4)">
						<Image hittest="false" id="ImageEmpty" class="inventory-item-image" src="file://{images}/custom_game/items/empty-inventory-slot.png"/>
						<DOTAItemImage hittest="false" id="ItemImageArmor"/>
						<Panel id="gems_container4" class="gems-equipment-container"/>
						<Panel hittest="false" id="Cooldown4" class="Cooldown">
							<Panel hittest="false" id="CooldownOverlay4" class="CooldownOverlay" />
							<Label hittest="false" id="CooldownTimer4" class="CooldownTimer" />
						</Panel>
					</Panel>
				</Panel>
				<Panel class="item_container"  id="weapon_glove_main_container" hittest="false">
					<Panel class="item_image" id="weapon_container" hittest="true"
						onactivate='EquipmentClick(1)'
						onmouseover="ItemShowTooltipInit(1)"
						onmouseout="ItemHideTooltipInit(1)">
						<Image hittest="false" id="ImageEmpty" class="inventory-item-image" src="file://{images}/custom_game/items/empty-inventory-slot.png"/>
						<DOTAItemImage hittest="false" id="ItemImageWeapon"/>
						<Panel id="gems_container1" class="gems-equipment-container"/>
						<Panel hittest="false" id="Cooldown1" class="Cooldown">
							<Panel hittest="false" id="CooldownOverlay1" class="CooldownOverlay" />
							<Label hittest="false" id="CooldownTimer1" class="CooldownTimer" />
						</Panel>
					</Panel>
					<Panel class="item_image" id="glove_container" hittest="true"
						onactivate='EquipmentClick(2)'
						onmouseover="ItemShowTooltipInit(2)"
						onmouseout="ItemHideTooltipInit(2)">
						<Image hittest="false" id="ImageEmpty" class="inventory-item-image" src="file://{images}/custom_game/items/empty-inventory-slot.png"/>
						<DOTAItemImage hittest="false" id="ItemImageGlove"/>
						<Panel id="gems_container2" class="gems-equipment-container"/>
						<Panel hittest="false" id="Cooldown2" class="Cooldown">
							<Panel hittest="false" id="CooldownOverlay2" class="CooldownOverlay" />
							<Label hittest="false" id="CooldownTimer2" class="CooldownTimer" />
						</Panel>
					</Panel>
				</Panel>
				<Panel class="item_container" id="boot_amulet_main_container" hittest="false">
					<Panel class="item_image" id="boot_container" hittest="true"
						onactivate='EquipmentClick(3)'
						onmouseover="ItemShowTooltipInit(3)"
						onmouseout="ItemHideTooltipInit(3)">
						<Image hittest="false" id="ImageEmpty" class="inventory-item-image" src="file://{images}/custom_game/items/empty-inventory-slot.png"/>
						<DOTAItemImage hittest="false" id="ItemImageBoot"/>
						<Panel id="gems_container3" class="gems-equipment-container"/>
						<Panel hittest="false" id="Cooldown3" class="Cooldown">
							<Panel hittest="false" id="CooldownOverlay3" class="CooldownOverlay" />
							<Label hittest="false" id="CooldownTimer3" class="CooldownTimer" />
						</Panel>
					</Panel>
					<Panel class="item_image" id="amulet_container" hittest="true"
						onactivate='EquipmentClick(5)'
						onmouseover="ItemShowTooltipInit(5)"
						onmouseout="ItemHideTooltipInit(5)">
						<Image hittest="false" id="ImageEmpty" class="inventory-item-image" src="file://{images}/custom_game/items/empty-inventory-slot.png"/>
						<DOTAItemImage hittest="false" id="ItemImageAmulet"/>
						<Panel id="gems_container5" class="gems-equipment-container"/>
						<Panel hittest="false" id="Cooldown5" class="Cooldown">
							<Panel hittest="false" id="CooldownOverlay5" class="CooldownOverlay" />
							<Label hittest="false" id="CooldownTimer5" class="CooldownTimer" />
						</Panel>
					</Panel>
				</Panel>
			</Panel>

		</Panel>
	</Panel>


</root>
