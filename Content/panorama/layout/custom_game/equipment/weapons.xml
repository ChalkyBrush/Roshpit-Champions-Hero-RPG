<root>
	<styles>
		<include src="file://{resources}/styles/dotastyles.css" />
		<include src="file://{resources}/styles/custom_game/menu/equipment.css" />
		<include src="file://{resources}/styles/custom_game/menu/menu.css" />
		<include src="file://{resources}/styles/custom_game/weapons.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/menu/new_weapons.js" />
	</scripts>
	<Panel class="weapons_root" hittest="false">
		<Panel id="weapons_main_container">
			<Panel id="weapons_container_bg" hittest="false">
			</Panel>
			<Panel id="weapons_container" hittest="false">
				<Panel class="weapon_stat_row">
					<Label id="weapon_current_level" class="weapon_label" hittest="false"></Label>
					<Label id="weapon_current_level_value" class="weapon_label_value" hittest="false" text="0"></Label>
				</Panel>
				<Panel class="weapon_stat_row">
					<Label id="weapon_max_level" class="weapon_label" hittest="false"></Label>
					<Label id="weapon_max_level_value" class="weapon_label_value" hittest="false" text="0"></Label>
				</Panel>
				<Panel id="weapon_exp_bar_container" hittest="false">
					<Panel id="weapon_exp_bar_progress" hittest="false">
					</Panel>
					<Label id="weapon_exp_label" hittest="false"></Label>
				</Panel>
			</Panel>
		</Panel>
	</Panel>


</root>
