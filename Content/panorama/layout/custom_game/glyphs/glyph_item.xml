<root>
	<styles>
		<include src="file://{resources}/styles/dotastyles.css" />
		<include src="file://{resources}/styles/custom_game/tooltips.css" />
		<include src="file://{resources}/styles/custom_game/weapons.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/glyphs/glyph_item.js" />
		<include src="file://{resources}/scripts/custom_game/equipment/item_tooltip.js" />
		<include src="file://{resources}/scripts/custom_game/heroes_custom/heroes_custom.js" />
	</scripts>
	<Panel class="glyph-panel" draggable="false" hittest="true">
		<Panel class="glyph_button" id="glyph_button" draggable="false"
			onmouseover="ItemShowTooltip('#glyph_image')"
			onmouseout="ItemHideTooltip('#glyph_image')">
			<Image class="glyph_image" id="glyph_image" src="file://{images}/custom_game/ui/empty-inventory-slot.png" hittest="true"/>

		</Panel>
	</Panel>
</root>
